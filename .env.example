# Configuração local de desenvolvimento
# Copie para .env.local e substitua os valores conforme necessário.
DATABASE_URL=mysql://mapa_dev:mapa_dev_local@127.0.0.1:3306/mapa_mandarim_dev

# MAPA_RUNTIME_MODE=preview    # preview usa fallback em memória; persistent exige banco

# Sessão local e Google OAuth
JWT_SECRET=gere-uma-chave-local-forte
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
EXPO_WEB_PREVIEW_URL=http://localhost:8081

# Variáveis expostas ao cliente Expo (não colocar aqui secrets)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
