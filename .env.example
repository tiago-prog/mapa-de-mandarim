# Configuração local de desenvolvimento
# Copie para .env.local e substitua os valores conforme necessário.
DATABASE_URL=mysql://mapa_dev:mapa_dev_local@127.0.0.1:3306/mapa_mandarim_dev

# MAPA_RUNTIME_MODE=preview    # preview usa fallback em memória; persistent exige banco

# Sessão do servidor e Google OAuth web — nunca expor o secret no app Expo
JWT_SECRET=gere-uma-chave-local-forte
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=seu-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Origens permitidas pelo OAuth/CORS web; use apenas origens controladas.
EXPO_WEB_PREVIEW_URL=http://localhost:8081
EXPO_WEB_URL=http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Variáveis públicas embutidas no cliente Expo. Não incluir secrets.
# Em dispositivo físico, substitua localhost por IP acessível ou túnel HTTPS.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=seu-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=seu-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_OAUTH_SCHEME=manusmapamandarim
